# Copy to .env.local and fill in. These are the PUBLIC Supabase values — they are
# safe to ship in the browser bundle (the anon key only grants what your RLS /
# Edge Function auth allows). Your GEMINI key is NOT here — it lives server-side
# as a Supabase secret (see supabase/functions/count + AI-SETUP.md).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
